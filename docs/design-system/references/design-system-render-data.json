  "rules": [
    {
      "n": "01",
      "t": "Shell constant",
      "d": "Rail clair 248 px (72 replié), barre de contexte 64 px, contenu max 1440 px. Gouttières 16 / 24 / 32."
    },
    {
      "n": "02",
      "t": "Contexte toujours visible",
      "d": "Boutique et période dans la barre de contexte ou sous le titre. Jamais cachés dans un menu."
    },
    {
      "n": "03",
      "t": "Une action primaire",
      "d": "Un seul bouton pétrole par en-tête de page. Le reste en outline ou ghost."
    },
    {
      "n": "04",
      "t": "Action avant information",
      "d": "Ordre : état → à traiter → chiffres → détail. Une alerte vit en haut, pas dans une colonne latérale."
    },
    {
      "n": "05",
      "t": "Chaque chiffre mène quelque part",
      "d": "Un indicateur ouvre sa source filtrée sur la même période et la même boutique."
    },
    {
      "n": "06",
      "t": "Tables lisibles",
      "d": "Lignes 52 px, montants à droite en chiffres tabulaires, statut en badge doux. Sous 768 px : cartes compactes."
    },
    {
      "n": "07",
      "t": "Bordure ou ombre",
      "d": "Cartes : bordure seule. Ombre : menus, dialogues, toasts. Jamais les deux."
    },
    {
      "n": "08",
      "t": "Cinq états prévus",
      "d": "Chargement (squelette de même forme), vide (phrase + action), erreur (+ réessayer), hors connexion, accès réservé."
    },
    {
      "n": "09",
      "t": "Mouvement bref",
      "d": "120–200 ms, ease-out, uniquement pour un changement d’état. Coupé sous prefers-reduced-motion."
    }
  ],
