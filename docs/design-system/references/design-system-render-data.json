  "anatomyNotes": [
    {
      "n": 1,
      "t": "Rail",
      "d": "Sections Pilotage / Opérations / Finance / Administration. Filtré par permission. Badge stock bas."
    },
    {
      "n": 2,
      "t": "Contexte",
      "d": "Fil d’Ariane, sélecteur de boutique, notifications, utilisateur et rôle."
    },
    {
      "n": 3,
      "t": "Salutation",
      "d": "Prénom, date, boutique, segment 7 j / 30 j."
    },
    {
      "n": 4,
      "t": "Actions",
      "d": "Nouvelle vente (primaire), Entrée de stock (outline). Selon permission."
    },
    {
      "n": 5,
      "t": "À traiter",
      "d": "Stock bas, crédits échus, caisses ouvertes, invitations. Masqué si vide → « Rien d’urgent »."
    },
    {
      "n": 6,
      "t": "Performance",
      "d": "CA + variation, Encaissements, Cashflow net, Marge brute (propriétaire seulement)."
    },
    {
      "n": 7,
      "t": "Activité",
      "d": "CA/jour, marge en superposition. Survol = lecture, clic = ventes du jour."
    },
    {
      "n": 8,
      "t": "Caisses",
      "d": "État par boutique, solde théorique, répartition par moyen de paiement."
    },
    {
      "n": 9,
      "t": "Ventes",
      "d": "5 dernières, référence mono, statut doux, montant à droite."
    },
    {
      "n": 10,
      "t": "Stock critique",
      "d": "3 références les plus proches du seuil, jauge warning/destructive."
    }
  ],
