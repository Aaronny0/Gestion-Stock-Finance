# URL du service métier, uniquement côté serveur Next.js.
# Le service implémente les contrats décrits dans docs/frontend-api.md.
# Aucun secret ne doit utiliser le préfixe NEXT_PUBLIC_.
# Sans cette variable, les écrans réels affichent un état non configuré.
# La démonstration locale reste disponible à /demo.
FRONTEND_API_URL=http://localhost:3001/api/v1/

# Better Auth (hébergé par le backend) : URL interne relayée par /api/auth/*.
AUTH_API_URL=http://localhost:3001
# Jamais de secret Better Auth, Google Client Secret ou SMTP ici.
