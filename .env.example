# URL du service métier VORTEX utilisée par le proxy serveur /api/v1/*.
# Renseigner cette valeur dans .env.local pour utiliser le backend réel.
FRONTEND_API_URL=

# Identité Supabase : URL et clé publique seulement.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Transition : NEXT_PUBLIC_SUPABASE_ANON_KEY reste accepté si publishable absente.
# Ne jamais préfixer un secret par NEXT_PUBLIC_.

# Back Admin et Storage : clés privilégiées exclusivement dans NestJS.
