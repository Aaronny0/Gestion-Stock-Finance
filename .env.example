# URL du service métier VORTEX utilisée par le proxy serveur /api/v1/*.
# Renseigner cette valeur dans .env.local pour utiliser le backend réel.
FRONTEND_API_URL=http://localhost:3001/api/v1/

# Better Auth tourne dans le backend Elysia (vortex-backend). Next.js relaie /api/auth/* vers cette URL
# (le navigateur ne parle qu'à son propre domaine). Local : http://localhost:3001 ; Docker/Dokploy : http://vortex-api:3001
AUTH_API_URL=http://localhost:3001

# URL publique de l'application (doit être égale à APP_URL côté backend).
APP_URL=http://localhost:3000

# Aucun secret ici : BETTER_AUTH_SECRET, Google Client Secret, SMTP et base de données restent dans le backend.
